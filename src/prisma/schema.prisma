datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

// ─── NextAuth Models ──────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("admin")
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Hotspot Manager Models ───────────────────────────────────────────────────

model HotspotRouter {
  id        String   @id @default(cuid())
  name      String
  host      String
  port      Int      @default(8728)
  username  String
  password  String
  useHttps  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     HotspotUser[]
  profiles  HotspotProfile[]
  vouchers  HotspotVoucher[]
  customers Customer[]
  ipPools   IpPool[]

  @@map("hotspot_routers")
}

model HotspotProfile {
  id             String  @id @default(cuid())
  routerId       String
  mikrotikId     String? // .id from RouterOS
  name           String
  rateLimit      String  @default("0/0") // e.g. "2M/2M"
  sharedUsers    Int     @default(1)
  sessionTimeout String?
  idleTimeout    String?
  addressPool    String?

  router   HotspotRouter  @relation(fields: [routerId], references: [id], onDelete: Cascade)
  users    HotspotUser[]
  vouchers HotspotVoucher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([routerId, name])
  @@map("hotspot_profiles")
}

model HotspotUser {
  id          String   @id @default(cuid())
  routerId    String
  profileId   String?
  mikrotikId  String?  // .id from RouterOS
  username    String
  password    String
  macAddress  String?
  ipAddress   String?
  limitUptime String?
  limitBytes  BigInt?
  comment     String?
  disabled    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  router  HotspotRouter   @relation(fields: [routerId], references: [id], onDelete: Cascade)
  profile HotspotProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@unique([routerId, username])
  @@map("hotspot_users")
}

model HotspotVoucher {
  id        String    @id @default(cuid())
  routerId  String
  profileId String
  code      String    @unique
  usedBy    String?
  usedAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  router  HotspotRouter  @relation(fields: [routerId], references: [id], onDelete: Cascade)
  profile HotspotProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("hotspot_vouchers")
}

// ─── Billing & Customer Models ────────────────────────────────────────────────

model Customer {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  fullName    String
  email       String?
  phone       String?
  address     String?
  city        String?
  serviceType String   @default("Hotspot") // Hotspot | PPPoE
  accountType String   @default("Personal") // Personal | Business
  status      String   @default("Active")  // Active | Banned | Disabled | Suspended | Inactive
  balance     Float    @default(0)
  autoRenew   Boolean  @default(false)
  planId      String?
  routerId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plan         Plan?          @relation(fields: [planId], references: [id], onDelete: SetNull)
  router       HotspotRouter? @relation(fields: [routerId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@map("customers")
}

model Plan {
  id           String   @id @default(cuid())
  name         String   @unique
  type         String   @default("Hotspot") // Hotspot | PPPoE
  price        Float    @default(0)
  validity     Int      @default(30)
  validityUnit String   @default("days")  // days | hours | months
  rateLimit    String   @default("0/0")
  dataLimit    BigInt?
  sharedUsers  Int      @default(1)
  autoRenew    Boolean  @default(false)
  isActive     Boolean  @default(true)
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customers    Customer[]
  transactions Transaction[]

  @@map("plans")
}

model Transaction {
  id            String   @id @default(cuid())
  customerId    String
  planId        String?
  amount        Float
  paymentMethod String   @default("Cash") // Cash | Balance | Online
  status        String   @default("Paid") // Paid | Unpaid | Canceled
  note          String?
  createdBy     String?
  createdAt     DateTime @default(now())
  expiresAt     DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan     Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@map("transactions")
}

// ─── Admin & System Models ────────────────────────────────────────────────────

model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  fullName  String?
  role      String   @default("Admin") // SuperAdmin | Admin | Agent | Sales
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

model IpPool {
  id        String   @id @default(cuid())
  name      String
  range     String
  routerId  String
  createdAt DateTime @default(now())

  router HotspotRouter @relation(fields: [routerId], references: [id], onDelete: Cascade)

  @@map("ip_pools")
}

model SystemLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  target    String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("system_logs")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}
